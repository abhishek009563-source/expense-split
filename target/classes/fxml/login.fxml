<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensesplitter.controller.LoginController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: -color-bg-base;">

    <!-- Left Branding Pane -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="28"
          style="-fx-background-color: linear-gradient(to bottom right, #0a1628, #1a2744, #0f172a);
                 -fx-padding: 52px 48px;
                 -fx-border-color: transparent -color-border transparent transparent;
                 -fx-border-width: 0 1 0 0;">

        <VBox spacing="8">
            <Label text="⚡ EXPENSE SPLITTER"
                   style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #3b82f6;
                          -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.4), 12, 0, 0, 0);"/>
            <Label text="Smart Group Expense Management &amp; Settlement System"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <Separator style="-fx-opacity: 0.15;"/>

        <VBox spacing="16">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Flexible Expense Splitting"
                           style="-fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
                    <Label text="Equal, exact amount, or exact percentages"
                           style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #3b82f6; -fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Greedy Debt Minimization"
                           style="-fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
                    <Label text="Min-Cash-Flow algorithm reduces transactions"
                           style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Email OTP Authentication"
                           style="-fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
                    <Label text="Passwordless &amp; secure – verified by real email"
                           style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #8b5cf6; -fx-font-size: 18px;"/>
                <VBox>
                    <Label text="Integer-Cent Accuracy"
                           style="-fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
                    <Label text="All balances computed in paise – no floating-point drift"
                           style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Demo accounts -->
        <VBox spacing="8"
              style="-fx-background-color: rgba(15,23,42,0.7); -fx-padding: 16px;
                     -fx-background-radius: 10px; -fx-border-color: #334155;
                     -fx-border-radius: 10px;">
            <Label text="🎭 Demo Accounts (Classic Login):"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;"/>
            <HBox spacing="8">
                <Button text="Rahul (Admin)" onAction="#handleFillDemoRahul"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 11px; -fx-padding: 5 10;"/>
                <Button text="Aman (Member)" onAction="#handleFillDemoAman"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 11px; -fx-padding: 5 10;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Right Form Pane -->
    <VBox alignment="CENTER" spacing="0"
          style="-fx-padding: 0; -fx-min-width: 460px; -fx-max-width: 480px;">

        <!-- Scrollable content area -->
        <VBox alignment="CENTER" spacing="20"
              style="-fx-padding: 44px 48px;">

            <!-- Header -->
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Welcome Back"
                       style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: -color-text-primary;"/>
                <Label text="Sign in to manage your group expenses"
                       style="-fx-font-size: 13px; -fx-text-fill: -color-text-secondary;"/>
            </VBox>

            <!-- Shared error label -->
            <Label fx:id="errorLabel" wrapText="true"
                   style="-fx-text-fill: #ef4444; -fx-font-weight: 600;
                          -fx-background-color: rgba(239,68,68,0.1); -fx-padding: 8 12;
                          -fx-background-radius: 6;"/>

            <!-- ═══ OTP Login Section ══════════════════════════════════════ -->
            <VBox spacing="14"
                  style="-fx-background-color: rgba(59,130,246,0.05); -fx-padding: 20px;
                         -fx-background-radius: 14px; -fx-border-color: rgba(59,130,246,0.2);
                         -fx-border-radius: 14px;">

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="✉" style="-fx-font-size: 16px; -fx-text-fill: #3b82f6;"/>
                    <VBox>
                        <Label text="Passwordless Login (Recommended)"
                               style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: #f8fafc;"/>
                        <Label text="Receive a secure OTP on your registered email"
                               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Email Address"
                           style="-fx-font-weight: 700; -fx-font-size: 12px; -fx-text-fill: -color-text-primary;"/>
                    <TextField fx:id="emailOtpField"
                               promptText="you@example.com"
                               style="-fx-font-size: 13px; -fx-padding: 10px 12px;"/>
                </VBox>

                <Label fx:id="otpStatusLabel" wrapText="true"
                       style="-fx-text-fill: #3b82f6; -fx-font-weight: 600;
                              -fx-background-color: rgba(59,130,246,0.08); -fx-padding: 6 10;
                              -fx-background-radius: 6;"/>

                <Button fx:id="sendOtpButton"
                        text="Send Login OTP →"
                        onAction="#handleSendLoginOtp"
                        maxWidth="Infinity"
                        styleClass="btn-primary"
                        style="-fx-font-size: 13px; -fx-padding: 11; -fx-font-weight: 800;"/>
            </VBox>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="12">
                <Separator HBox.hgrow="ALWAYS" style="-fx-opacity: 0.25;"/>
                <Label text="or use password"
                       style="-fx-text-fill: -color-text-muted; -fx-font-size: 12px;"/>
                <Separator HBox.hgrow="ALWAYS" style="-fx-opacity: 0.25;"/>
            </HBox>

            <!-- ═══ Classic Password Login Section ════════════════════════ -->
            <VBox spacing="12">
                <VBox spacing="6">
                    <Label text="Username or Email"
                           style="-fx-font-weight: 600; -fx-font-size: 12px; -fx-text-fill: -color-text-primary;"/>
                    <TextField fx:id="usernameField"
                               promptText="e.g. rahul or rahul@example.com"
                               style="-fx-font-size: 13px; -fx-padding: 10px 12px;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Password"
                           style="-fx-font-weight: 600; -fx-font-size: 12px; -fx-text-fill: -color-text-primary;"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter your password"
                                   style="-fx-font-size: 13px; -fx-padding: 10px 12px;"/>
                </VBox>

                <Button text="Sign In with Password →"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        styleClass="btn-secondary"
                        style="-fx-font-size: 13px; -fx-padding: 11;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.2;"/>

            <!-- Register link -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?"
                       style="-fx-text-fill: -color-text-secondary; -fx-font-size: 13px;"/>
                <Hyperlink text="Create Account"
                           onAction="#handleGoToRegister"
                           style="-fx-font-weight: bold; -fx-text-fill: -color-primary;"/>
            </HBox>

        </VBox>
    </VBox>

</HBox>
