<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensesplitter.controller.OtpVerifyController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: -color-bg-base;">

    <!-- Left Branding Pane -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="28"
          style="-fx-background-color: linear-gradient(to bottom right, #0a1628, #1a2744, #0f172a);
                 -fx-padding: 56px 48px;
                 -fx-border-color: transparent -color-border transparent transparent;
                 -fx-border-width: 0 1 0 0;">

        <VBox spacing="10" alignment="CENTER_LEFT">
            <Label text="⚡ EXPENSE SPLITTER"
                   style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #3b82f6;
                          -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.4), 12, 0, 0, 0);"/>
            <Label text="Smart Group Expense Management"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <Separator style="-fx-opacity: 0.15;"/>

        <!-- Security Visual -->
        <VBox spacing="24" alignment="CENTER_LEFT">
            <VBox spacing="8" alignment="CENTER"
                  style="-fx-background-color: rgba(59,130,246,0.08); -fx-padding: 28px;
                         -fx-background-radius: 20px; -fx-border-color: rgba(59,130,246,0.2);
                         -fx-border-radius: 20px;">
                <Label text="🔒"
                       style="-fx-font-size: 52px;"/>
                <Label text="Email Verification"
                       style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #f8fafc;"/>
                <Label text="We sent a secure one-time code to your inbox"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" wrapText="true"/>
            </VBox>

            <VBox spacing="12">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-size: 14px;"/>
                    <VBox>
                        <Label text="Cryptographically Secure" style="-fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-font-size: 12px;"/>
                        <Label text="6-digit code generated with SecureRandom" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #3b82f6; -fx-font-size: 14px;"/>
                    <VBox>
                        <Label text="Expires in 5 Minutes" style="-fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-font-size: 12px;"/>
                        <Label text="Hashed &amp; never stored in plain text" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="✓" style="-fx-font-weight: bold; -fx-text-fill: #10b981; -fx-font-size: 14px;"/>
                    <VBox>
                        <Label text="Single Use Only" style="-fx-font-weight: bold; -fx-text-fill: #f8fafc; -fx-font-size: 12px;"/>
                        <Label text="OTP is invalidated immediately on use" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="💡 Check your Spam folder if you don't see the email."
               style="-fx-font-size: 11px; -fx-text-fill: #64748b;" wrapText="true"/>
    </VBox>

    <!-- Right OTP Form Pane -->
    <VBox alignment="CENTER" spacing="20"
          style="-fx-padding: 48px 44px; -fx-min-width: 440px; -fx-max-width: 460px;">

        <!-- Header -->
        <VBox spacing="6" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Verify Your Email"
                   style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: -color-text-primary;"/>
            <Label fx:id="subtitleLabel" text="Enter the 6-digit code sent to your inbox"
                   style="-fx-font-size: 13px; -fx-text-fill: -color-text-secondary;"/>
        </VBox>

        <!-- Purpose Hint -->
        <Label fx:id="purposeHintLabel" text=""
               style="-fx-font-size: 12px; -fx-text-fill: #60a5fa; -fx-font-weight: 600;"/>

        <!-- Email display -->
        <VBox spacing="4"
              style="-fx-background-color: rgba(59,130,246,0.06); -fx-padding: 12px 16px;
                     -fx-background-radius: 10px; -fx-border-color: rgba(59,130,246,0.15);
                     -fx-border-radius: 10px;">
            <Label text="Code sent to:"
                   style="-fx-font-size: 11px; -fx-text-fill: -color-text-muted;"/>
            <Label fx:id="emailDisplayLabel" text=""
                   style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #60a5fa;"/>
        </VBox>

        <!-- Error / Success messages -->
        <Label fx:id="errorLabel" wrapText="true"
               style="-fx-text-fill: #ef4444; -fx-font-weight: 600;
                      -fx-background-color: rgba(239,68,68,0.1); -fx-padding: 8 12;
                      -fx-background-radius: 6;"/>
        <Label fx:id="successLabel" wrapText="true"
               style="-fx-text-fill: #10b981; -fx-font-weight: 600;
                      -fx-background-color: rgba(16,185,129,0.1); -fx-padding: 8 12;
                      -fx-background-radius: 6;"/>

        <!-- OTP input -->
        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Enter 6-Digit OTP"
                   style="-fx-font-weight: 700; -fx-font-size: 13px; -fx-text-fill: -color-text-primary;"/>
            <TextField fx:id="otpField"
                       promptText="e.g.  4 8 2 1 9 3"
                       maxWidth="Infinity"
                       style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-alignment: center;
                              -fx-letter-spacing: 8px; -fx-padding: 14px 18px;
                              -fx-background-color: #0f172a; -fx-text-fill: #60a5fa;
                              -fx-border-color: #3b82f6; -fx-border-radius: 10px;
                              -fx-background-radius: 10px;
                              -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.2), 8, 0, 0, 2);"/>
            <Label text="The code is auto-submitted when all 6 digits are entered."
                   style="-fx-font-size: 11px; -fx-text-fill: -color-text-muted;"/>
        </VBox>

        <!-- Verify button -->
        <Button fx:id="verifyButton" text="Verify Code →"
                onAction="#handleVerify"
                maxWidth="Infinity"
                styleClass="btn-primary"
                style="-fx-font-size: 14px; -fx-padding: 13; -fx-font-weight: 800;"/>

        <!-- Resend section -->
        <VBox spacing="6" alignment="CENTER">
            <Label fx:id="timerLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #f59e0b; -fx-font-weight: 600;"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="Didn't receive it?"
                       style="-fx-text-fill: -color-text-secondary; -fx-font-size: 13px;"/>
                <Button fx:id="resendButton" text="Resend OTP"
                        onAction="#handleResend"
                        style="-fx-background-color: transparent; -fx-text-fill: #3b82f6;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: transparent;
                               -fx-font-size: 13px; -fx-padding: 0;"/>
            </HBox>
        </VBox>

        <Separator style="-fx-opacity: 0.2;"/>

        <!-- Back link -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="Wrong email?" style="-fx-text-fill: -color-text-secondary; -fx-font-size: 13px;"/>
            <Hyperlink text="Go back" onAction="#handleBack"
                       style="-fx-font-weight: bold; -fx-text-fill: -color-primary;"/>
        </HBox>

    </VBox>

</HBox>
