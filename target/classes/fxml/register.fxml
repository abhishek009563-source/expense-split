<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensesplitter.controller.RegisterController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: -color-bg-base;">

    <!-- Left Branding Pane -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="28"
          style="-fx-background-color: linear-gradient(to bottom right, #0a1628, #1a2744, #0f172a);
                 -fx-padding: 56px 48px;
                 -fx-border-color: transparent -color-border transparent transparent;
                 -fx-border-width: 0 1 0 0;">

        <VBox spacing="10">
            <Label text="⚡ EXPENSE SPLITTER"
                   style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #3b82f6;
                          -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.4), 12, 0, 0, 0);"/>
            <Label text="Smart Group Expense Management &amp; Settlement"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <Separator style="-fx-opacity: 0.15;"/>

        <!-- How it works steps -->
        <VBox spacing="20">
            <Label text="How Registration Works"
                   style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #f8fafc;"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox alignment="CENTER" minWidth="36" minHeight="36"
                      style="-fx-background-color: #3b82f6; -fx-background-radius: 50%;
                             -fx-padding: 4px;">
                    <Label text="1" style="-fx-font-weight: 800; -fx-text-fill: white; -fx-font-size: 14px;"/>
                </VBox>
                <VBox>
                    <Label text="Enter Your Name &amp; Email"
                           style="-fx-font-weight: 700; -fx-text-fill: #f8fafc; -fx-font-size: 13px;"/>
                    <Label text="No password needed – email is your identity"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox alignment="CENTER" minWidth="36" minHeight="36"
                      style="-fx-background-color: #10b981; -fx-background-radius: 50%;
                             -fx-padding: 4px;">
                    <Label text="2" style="-fx-font-weight: 800; -fx-text-fill: white; -fx-font-size: 14px;"/>
                </VBox>
                <VBox>
                    <Label text="Get OTP in Your Inbox"
                           style="-fx-font-weight: 700; -fx-text-fill: #f8fafc; -fx-font-size: 13px;"/>
                    <Label text="A 6-digit code valid for 5 minutes"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox alignment="CENTER" minWidth="36" minHeight="36"
                      style="-fx-background-color: #8b5cf6; -fx-background-radius: 50%;
                             -fx-padding: 4px;">
                    <Label text="3" style="-fx-font-weight: 800; -fx-text-fill: white; -fx-font-size: 14px;"/>
                </VBox>
                <VBox>
                    <Label text="Account Created Instantly"
                           style="-fx-font-weight: 700; -fx-text-fill: #f8fafc; -fx-font-size: 13px;"/>
                    <Label text="Verified &amp; logged in – straight to your dashboard"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Security badge -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: rgba(16,185,129,0.08); -fx-padding: 12px 16px;
                     -fx-background-radius: 10px; -fx-border-color: rgba(16,185,129,0.15);
                     -fx-border-radius: 10px;">
            <Label text="🔒" style="-fx-font-size: 18px;"/>
            <VBox>
                <Label text="OTP hashed with SHA-256"
                       style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #10b981;"/>
                <Label text="Never stored in plain text"
                       style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Right Registration Form Pane -->
    <VBox alignment="CENTER" spacing="22"
          style="-fx-padding: 52px 48px; -fx-min-width: 460px; -fx-max-width: 480px;">

        <!-- Header -->
        <VBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Create Account"
                   style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: -color-text-primary;"/>
            <Label text="Enter your name and email to get started"
                   style="-fx-font-size: 13px; -fx-text-fill: -color-text-secondary;"/>
        </VBox>

        <!-- Error / Status labels -->
        <Label fx:id="errorLabel" wrapText="true"
               style="-fx-text-fill: #ef4444; -fx-font-weight: 600;
                      -fx-background-color: rgba(239,68,68,0.1); -fx-padding: 8 12;
                      -fx-background-radius: 6;"/>
        <Label fx:id="statusLabel" wrapText="true"
               style="-fx-text-fill: #3b82f6; -fx-font-weight: 600;
                      -fx-background-color: rgba(59,130,246,0.1); -fx-padding: 8 12;
                      -fx-background-radius: 6;"/>

        <!-- Form fields -->
        <VBox spacing="18" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Full Name *"
                       style="-fx-font-weight: 700; -fx-font-size: 13px; -fx-text-fill: -color-text-primary;"/>
                <TextField fx:id="fullNameField"
                           promptText="e.g. Rahul Sharma"
                           style="-fx-font-size: 14px; -fx-padding: 11px 14px;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Email Address *"
                       style="-fx-font-weight: 700; -fx-font-size: 13px; -fx-text-fill: -color-text-primary;"/>
                <TextField fx:id="emailField"
                           promptText="you@example.com"
                           style="-fx-font-size: 14px; -fx-padding: 11px 14px;"/>
                <Label text="A 6-digit OTP will be sent to this address."
                       style="-fx-font-size: 11px; -fx-text-fill: -color-text-muted;"/>
            </VBox>
        </VBox>

        <!-- CTA button -->
        <Button fx:id="createAccountButton"
                text="Create Account →"
                onAction="#handleRegister"
                maxWidth="Infinity"
                styleClass="btn-primary"
                style="-fx-font-size: 14px; -fx-padding: 13; -fx-font-weight: 800;"/>

        <Separator style="-fx-opacity: 0.2;"/>

        <!-- Login link -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="Already have an account?"
                   style="-fx-text-fill: -color-text-secondary; -fx-font-size: 13px;"/>
            <Hyperlink text="Sign In"
                       onAction="#handleBackToLogin"
                       style="-fx-font-weight: bold; -fx-text-fill: -color-primary;"/>
        </HBox>

    </VBox>

</HBox>
