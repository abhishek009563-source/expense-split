<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expensesplitter.controller.NotificationsController"
            fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">

    <VBox spacing="18" style="-fx-padding: 6 12 30 12;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Participant Notifications &amp; Delivery History" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -color-text-primary;"/>
                <Label fx:id="notificationCountLabel" text="Audit trail of multi-channel Email, SMS, and in-app notifications." style="-fx-font-size: 13px; -fx-text-fill: -color-text-secondary;"/>
            </VBox>

            <HBox spacing="10">
                <Button text="🚀  Test Notification" onAction="#handleSendTestNotification" styleClass="btn-secondary"/>
                <Button text="🔄  Retry Delivery" onAction="#handleRetrySelected" styleClass="btn-primary"/>
                <Button text="✓✓  Mark All Read" onAction="#handleMarkAllRead" styleClass="btn-secondary"/>
            </HBox>
        </HBox>

        <!-- KPI Summary Cards (4 Cards) -->
        <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="card">
                <Label text="TOTAL DISPATCHED" styleClass="card-subtitle"/>
                <Label fx:id="totalNotifLabel" text="0" styleClass="metric-value"/>
                <Label text="All channels combined" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="card">
                <Label text="EMAILS SENT" styleClass="card-subtitle"/>
                <Label fx:id="emailsSentLabel" text="0" styleClass="metric-value, metric-blue"/>
                <Label text="Automated bill breakdowns" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="card">
                <Label text="SMS ALERTS SENT" styleClass="card-subtitle"/>
                <Label fx:id="smsSentLabel" text="0" styleClass="metric-value, metric-green"/>
                <Label text="Twilio / MSG91 instant alerts" style="-fx-font-size: 11px; -fx-text-fill: #10b981;"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="card">
                <Label text="FAILED DELIVERIES" styleClass="card-subtitle"/>
                <Label fx:id="failedNotifLabel" text="0" styleClass="metric-value, metric-red"/>
                <Label text="Retryable attempts" style="-fx-font-size: 11px; -fx-text-fill: #ef4444;"/>
            </VBox>
        </HBox>

        <!-- Filter Bar -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 10 14;">
            <TextField fx:id="searchField" promptText="🔍 Search notifications by participant, email, phone or title..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="channelFilterCombo" prefWidth="160"/>
            <ComboBox fx:id="statusFilterCombo" prefWidth="160"/>
        </HBox>

        <!-- History Table -->
        <VBox VBox.vgrow="ALWAYS" spacing="10" styleClass="card">
            <TableView fx:id="notificationsTable" prefHeight="380">
                <columns>
                    <TableColumn fx:id="colChannel" text="Channel" prefWidth="110"/>
                    <TableColumn fx:id="colRecipient" text="Participant" prefWidth="140"/>
                    <TableColumn fx:id="colContact" text="Recipient Contact" prefWidth="170"/>
                    <TableColumn fx:id="colTitle" text="Title / Subject" prefWidth="200"/>
                    <TableColumn fx:id="colMessage" text="Message Content" prefWidth="320"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="140"/>
                    <TableColumn fx:id="colDate" text="Sent At" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
